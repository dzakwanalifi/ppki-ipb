{
  "version": "PPKI-IPB-2024",
  "citation_system": "Harvard (Name-Year)",
  "standard_style": "CSE 8th (Modified)",
  "common_rules": {
    "author_format": "FamilyName InitialInitial (No periods, e.g., 'Suhardiyanto H').",
    "year_format": "YYYY.",
    "passive_voice": true,
    "no_dan_in_bibliography": true
  },
  "technical_notation": {
    "decimal_separator": ",",
    "thousands_separator": ".",
    "unit_spacing": "Always add a space between number and unit (e.g., '100 kg', '20 °C').",
    "italic_vs_upright": {
      "variables_symbols": "italic (e.g., *V*, *x*, *y*)",
      "units_constants": "upright (e.g., kg, m, s, V, volt)"
    },
    "math_operators": "Add spaces before and after operators (e.g., 'x = y + 1').",
    "decimal_series_separator": "semicolon (e.g., '3,4; 0,5; 4,5')"
  },
  "illustration_rules": {
    "table": {
      "title_position": "above",
      "title_ending_period": false,
      "horizontal_lines_count": 3,
      "vertical_lines_allowed": false
    },
    "figure": {
      "title_position": "below",
      "title_ending_period": false
    }
  },
  "schemas": {
    "journal": {
      "template": "{authors}. {year}. {title}. {journal_name}. {volume}({issue}):{pages}. {doi}"
    },
    "book": {
      "template": "{authors}. {year}. {title}. [{edition}]. {city}: {publisher}."
    }
  }
}
